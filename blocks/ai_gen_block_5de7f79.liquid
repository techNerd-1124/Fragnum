{% doc %}
  @prompt
    generate a testimonial section in caraousel form
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonial-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-testimonial-carousel__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
  }

  .ai-testimonial-carousel__slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-testimonial-carousel__slider-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: 24px;
  }

  .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
    min-width: calc(100% - 0px);
    flex-shrink: 0;
    box-sizing: border-box;
  }

  @media (min-width: 750px) {
    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      min-width: calc(50% - 12px);
    }
  }

  @media (min-width: 990px) {
    .ai-testimonial-carousel__slide-{{ ai_gen_id }} {
      min-width: calc(33.333% - 16px);
    }
  }

  .ai-testimonial-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-testimonial-carousel__rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
  }

  .ai-testimonial-carousel__quote-{{ ai_gen_id }} {
    color: {{ block.settings.quote_color }};
    font-size: {{ block.settings.quote_size }}px;
    line-height: 1.6;
    flex-grow: 1;
  }

  .ai-testimonial-carousel__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-testimonial-carousel__avatar-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: {{ block.settings.avatar_background }};
  }

  .ai-testimonial-carousel__avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-carousel__author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-testimonial-carousel__name-{{ ai_gen_id }} {
    color: {{ block.settings.name_color }};
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-testimonial-carousel__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
  }

  .ai-testimonial-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-testimonial-carousel__button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    border: 1px solid {{ block.settings.button_border }};
    color: {{ block.settings.button_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-testimonial-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_color }};
  }

  .ai-testimonial-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonial-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.3s ease;
    border: none;
    padding: 0;
  }

  .ai-testimonial-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-testimonial-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-testimonial-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.3;
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }}
  class="ai-testimonial-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonial-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-testimonial-carousel__header-{{ ai_gen_id }}">
        <h2 class="ai-testimonial-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign has_testimonials = false %}
    {% for i in (1..6) %}
      {% liquid
        assign name_key = 'testimonial_' | append: i | append: '_name'
        assign name = block.settings[name_key]
        if name != blank
          assign has_testimonials = true
          break
        endif
      %}
    {% endfor %}

    {% if has_testimonials %}
      <div class="ai-testimonial-carousel__slider-wrapper-{{ ai_gen_id }}">
        <div class="ai-testimonial-carousel__slider-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% liquid
              assign name_key = 'testimonial_' | append: i | append: '_name'
              assign title_key = 'testimonial_' | append: i | append: '_title'
              assign quote_key = 'testimonial_' | append: i | append: '_quote'
              assign rating_key = 'testimonial_' | append: i | append: '_rating'
              assign image_key = 'testimonial_' | append: i | append: '_image'

              assign name = block.settings[name_key]
              assign title = block.settings[title_key]
              assign quote = block.settings[quote_key]
              assign rating = block.settings[rating_key]
              assign image = block.settings[image_key]
            %}

            {% if name != blank %}
              <div class="ai-testimonial-carousel__slide-{{ ai_gen_id }}">
                <div class="ai-testimonial-carousel__card-{{ ai_gen_id }}">
                  <div class="ai-testimonial-carousel__rating-{{ ai_gen_id }}">
                    {% for star in (1..rating) %}
                      <svg
                        class="ai-testimonial-carousel__star-{{ ai_gen_id }}"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                      </svg>
                    {% endfor %}
                  </div>

                  <div class="ai-testimonial-carousel__quote-{{ ai_gen_id }}">
                    {{ quote }}
                  </div>

                  <div class="ai-testimonial-carousel__author-{{ ai_gen_id }}">
                    <div class="ai-testimonial-carousel__avatar-{{ ai_gen_id }}">
                      {% if image %}
                        <img
                          src="{{ image | image_url: width: 96 }}"
                          alt="{{ name | escape }}"
                          width="48"
                          height="48"
                          loading="lazy"
                        >
                      {% else %}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                          <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                      {% endif %}
                    </div>
                    <div class="ai-testimonial-carousel__author-info-{{ ai_gen_id }}">
                      <p class="ai-testimonial-carousel__name-{{ ai_gen_id }}">{{ name }}</p>
                      {% if title != blank %}
                        <p class="ai-testimonial-carousel__title-{{ ai_gen_id }}">{{ title }}</p>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-testimonial-carousel__controls-{{ ai_gen_id }}">
        <button
          class="ai-testimonial-carousel__button-{{ ai_gen_id }} ai-testimonial-carousel__prev-{{ ai_gen_id }}"
          aria-label="Previous testimonial"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-testimonial-carousel__dots-{{ ai_gen_id }}"></div>

        <button
          class="ai-testimonial-carousel__button-{{ ai_gen_id }} ai-testimonial-carousel__next-{{ ai_gen_id }}"
          aria-label="Next testimonial"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-testimonial-carousel__empty-state-{{ ai_gen_id }}">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <p>Add your first testimonial to get started</p>
      </div>
    {% endif %}
  </div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-testimonial-carousel__slider-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-testimonial-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-testimonial-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-testimonial-carousel__next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-testimonial-carousel__dots-{{ ai_gen_id }}');

        if (!this.slider || this.slides.length === 0) return;

        this.slidesPerView = this.getSlidesPerView();
        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);

        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();

        if ({{ block.settings.autoplay }}) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => {
          this.slidesPerView = this.getSlidesPerView();
          this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
          this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
          this.updateCarousel();
        });
      }

      getSlidesPerView() {
        if (window.innerWidth >= 990) return 3;
        if (window.innerWidth >= 750) return 2;
        return 1;
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;
        
        for (let i = 0; i < dotsCount; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-testimonial-carousel__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to testimonial ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        this.slider.addEventListener('mouseenter', () => this.stopAutoplay());
        this.slider.addEventListener('mouseleave', () => {
          if ({{ block.settings.autoplay }}) {
            this.startAutoplay();
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = 24;
        const offset = -(this.currentIndex * (slideWidth + gap));
        
        this.slider.style.transform = `translateX(${offset}px)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex === this.maxIndex;

        const dots = this.dotsContainer.querySelectorAll('.ai-testimonial-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          if (this.currentIndex < this.maxIndex) {
            this.next();
          } else {
            this.currentIndex = 0;
            this.updateCarousel();
          }
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('testimonial-carousel-{{ ai_gen_id }}', TestimonialCarousel{{ ai_gen_id }});
  })();
</script>


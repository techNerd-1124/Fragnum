
{%- if section.blocks.size > 0 -%}

<script src="{{ 'custom-faq.js' | asset_url }}" defer="defer"></script>
{{ 'custom-faq-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

{%- endstyle -%}

<div class="page-width custom__faq--wrapper section-{{ section.id }}-padding">
    <div class="custom__faq--heading">
        {%- if section.settings.heading -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
    </div>
    <div class="custom__faq--content">
        {%- if section.settings.image -%}
        <div class="custom__faq--media">
            {{ section.settings.image | image_url: width: '1000' | image_tag }}
        </div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
        <div class="custom__faq--accordions">
            {% if section.settings.description %}
            <h2 class="custom__fa--description">
                {{ section.settings.description }}
            </h2>
            {% endif %}
            {% for block in section.blocks %}
            <accordion-element>
                <div class="custom__faq__accordion--item">
                <div class="accordion__item--question"> 
                <h4> {{ block.settings.question }} </h4>
                <div class="accordion__item-icon">
                </div>    
                </div>
                {%- if block.settings.question and block.settings.answer -%}
                <div class="accordion__item--answer">{{ block.settings.answer }} </div>
                {%- endif -%}
                </div>
            </accordion-element>
            {% endfor %}
        </div>
        {%- endif -%}
    </div>
</div>

{% endif %}

{%  schema  %} 
{
    "name": "Custom FAQ Section",
    "tag": "section",
    "class": "section",
    "enabled_on": {
        "templates": ["product"]
    },
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Heading"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Description</p>",
            "info": "It will be only display on right side, above the FAQ Blocks"
        },
        {
            "type": "image_picker",
            "id" : "image",
            "label": "Image",
            "info" : "Recommended size will be 680 X 456 in pixels"
        },
        {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
    ],
    "blocks": [{
        "type": "accordion",
        "name": "Accordion",
        "settings": [{
            "type" : "text",
            "id": "question",
            "label": "Question",
            "default" :"Accordion Question"
        },
        {
            "type" : "richtext",
            "id" : "answer",
            "label" : "Answer"
        }
        ]
        }],
    "presets": [{
        "name": "Custom FAQ Section",
        "blocks": [
            {
            "type": "accordion"
            }
    ]
    }]
}

{% endschema %}
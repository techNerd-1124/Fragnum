{% style %}
  .discover-stories-container {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }

  @media screen and (max-width: 900px) {
    .discover-stories-container {
      padding-top: {{ section.settings.mobile_top_padding }}px;
      padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
    }
  }
  
  .section-header {
    text-align: {{ section.settings.header_appearance }};
  }
{% endstyle %}
<style>
  .section-header {
    font-size: 28px;
    font-weight: 300;
    letter-spacing: 2px;
    margin-bottom: 40px;
    color: #333;
  }

  .section-header span {
    font-weight: 700;
  }

  .carousel-container {
    position: relative;
    overflow: hidden;
    padding-bottom: 10px;
  }

  .carousel-wrapper {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .review-card {
    min-width: 100%;
    padding: 0 10px;
  }

  @media (min-width: 768px) {
    .review-card {
      min-width: 50%;
    }
  }

  @media (min-width: 1024px) {
    .review-card {
      min-width: 33.333%;
    }
  }

  .card-content {
    background: white;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .product-image-container {
    position: relative;
    background: #3a3a3a;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }

  .warning-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: #c94a2a;
    color: white;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .warning-badge div:first-child {
    margin-bottom: 2px;
  }

  .product-image-text {
    color: white;
    font-size: 18px;
    letter-spacing: 3px;
    text-align: center;
  }

  .user-images {
    display: flex;
    gap: 8px;
    padding: 20px 20px 15px;
    overflow-x: auto;
  }

  .user-image {
    min-width: 60px;
    height: 60px;
    background: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: white;
    text-align: center;
    line-height: 1.3;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .user-image:hover {
    transform: scale(1.05);
  }

  .review-content {
    padding: 0 20px 20px;
  }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }

  .review-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .stars {
    display: flex;
    gap: 4px;
  }

  .star {
    color: #f5a623;
    font-size: 22px;
  }

  .star.empty {
    color: #ddd;
  }

  .comments {
    margin-bottom: 20px;
  }

  .comment {
    font-size: 14px;
    color: #333;
    margin-bottom: 5px;
    letter-spacing: 0.3px;
  }

  .review-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 15px;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .tag {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tag-label {
    font-weight: 600;
    margin-bottom: 3px;
  }

  .tag-value {
    font-weight: 400;
  }

  .full-story-link {
    text-decoration: underline;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1px;
    color: #333;
    cursor: pointer;
    display: inline-block;
    margin-bottom: 15px;
  }

  .reviewer-info {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #666;
    letter-spacing: 0.5px;
  }

  .verified-icon {
    width: 16px;
    height: 16px;
    background: #333;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 10px;
  }

  .carousel-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
  }

  .nav-arrow {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    transition: transform 0.2s;
  }

  .nav-arrow:hover {
    transform: scale(1.1);
  }

  .nav-arrow svg {
    width: 40px;
    height: 40px;
    stroke: #333;
    stroke-width: 2;
  }

  .nav-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .carousel-dots {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #999;
    cursor: pointer;
    transition: background 0.3s;
  }

  .dot.active {
    background: #333;
  }

  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    overflow-y: auto;
    animation: fadeIn 0.3s ease-in-out;
  }

  .modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-content {
    background: white;
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 2px;
    animation: slideUp 0.3s ease-in-out;
    position: relative;
  }

  @keyframes slideUp {
    from {
      transform: translateY(50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
  }

  .modal-close:hover {
    background: white;
    transform: scale(1.1);
  }

  .modal-image-container {
    position: relative;
    background: #3a3a3a;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }

  .modal-body {
    padding: 40px;
  }

  .modal-user-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 15px;
    margin-bottom: 30px;
  }

  .modal-user-image {
    width: 100%;
    aspect-ratio: 1;
    background: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: white;
    text-align: center;
    line-height: 1.3;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .modal-user-image:hover {
    transform: scale(1.05);
  }

  .modal-review-header {
    margin-bottom: 25px;
  }

  .modal-title {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 15px;
  }

  .modal-stars {
    display: flex;
    gap: 6px;
  }

  .modal-stars .star {
    font-size: 28px;
  }

  .modal-comments {
    margin-bottom: 30px;
    line-height: 1.8;
  }

  .modal-comment {
    font-size: 16px;
    color: #333;
    margin-bottom: 10px;
  }

  .modal-full-review {
    font-size: 15px;
    color: #555;
    line-height: 1.8;
    margin-bottom: 30px;
  }

  .modal-review-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 30px;
    padding: 25px;
    background: #f5f5f5;
    border-radius: 2px;
  }

  .modal-tag {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .modal-tag-label {
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1px;
    margin-bottom: 5px;
  }

  .modal-tag-value {
    font-weight: 400;
    font-size: 14px;
  }

  .modal-reviewer-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: #666;
    letter-spacing: 0.5px;
    padding-top: 20px;
    border-top: 1px solid #e0e0e0;
  }

  @media (max-width: 768px) {
    .modal-content {
      max-height: 95vh;
    }

    .modal-image-container {
      height: 300px;
    }

    .modal-body {
      padding: 30px 20px;
    }

    .modal-title {
      font-size: 24px;
    }

    .modal-user-images {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    }

    .modal-review-tags {
      gap: 15px;
      padding: 20px 15px;
    }
  }
</style>

<div class="discover-stories-container">
  <div class="discover-section">
    {% if section.settings.section_header != blank %}
      <h2 class="section-header">{{ section.settings.section_header }}</h2>
    {% else %}
      <h2 class="section-header">> DISCOVER <span>STORIES</span></h2>
    {% endif %}

    <div class="carousel-container">
      <div class="carousel-wrapper" id="carouselWrapper">
        {% for block in section.blocks %}
          {% assign review = block.settings %}
          {% assign star_count = 5 %}
          {% case review.review_star %}
            {% when 'one' %}
              {% assign star_count = 1 %}
            {% when 'two' %}
              {% assign star_count = 2 %}
            {% when 'three' %}
              {% assign star_count = 3 %}
            {% when 'four' %}
              {% assign star_count = 4 %}
            {% when 'five' %}
              {% assign star_count = 5 %}
          {% endcase %}

          <div class="review-card" data-block-id="{{ block.id }}">
            <div class="card-content">
              <div class="product-image-container" 
                   {% if review.review_product.featured_media %}
                     style="background-image: url('{{ review.review_product.featured_media | img_url: 'master' }}');"
                   {% endif %}>
                <div class="warning-badge">
                  <div>WEARING:</div>
                  <div>{{ review.review_product.title | upcase | default: 'MATCHA NOSTALGIA' }}</div>
                </div>
                {% unless review.review_product.featured_media %}
                  <div class="product-image-text">PRODUCT IMAGE</div>
                {% endunless %}
              </div>

              <div class="user-images">
                {% if review.review_image_1 %}
                  <div class="user-image" style="background-image: url('{{ review.review_image_1 | img_url: 'small' }}'); background-size: cover; background-position: center;"></div>
                {% else %}
                  <div class="user-image">USER<br />IMAGES//<br />VIDEOS</div>
                {% endif %}
                
                {% if review.review_image_2 %}
                  <div class="user-image" style="background-image: url('{{ review.review_image_2 | img_url: 'small' }}'); background-size: cover; background-position: center;"></div>
                {% else %}
                  <div class="user-image">USER<br />IMAGES//<br />VIDEOS</div>
                {% endif %}
                
                {% if review.review_image_3 %}
                  <div class="user-image" style="background-image: url('{{ review.review_image_3 | img_url: 'small' }}'); background-size: cover; background-position: center;"></div>
                {% else %}
                  <div class="user-image">USER<br />IMAGES//<br />VIDEOS</div>
                {% endif %}
              </div>

              <div class="review-content">
                <div class="review-header">
                  <h3 class="review-title">{{ review.review_title | default: 'TITLE' }}</h3>
                  <div class="stars">
                    {% for i in (1..5) %}
                      {% if i <= star_count %}
                        <span class="star">★</span>
                      {% else %}
                        <span class="star empty">★</span>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>

                <div class="review-tags">
                  <div class="tag">
                    <div class="tag-label">RECOMMEND</div>
                    <div class="tag-value">{{ review.recommend_text | default: 'YES' }}</div>
                  </div>
                  <div class="tag">
                    <div class="tag-label">PERFORMANCE</div>
                    <div class="tag-value">{{ review.performance_text | default: 'GOOD' }}</div>
                  </div>
                  <div class="tag">
                    <div class="tag-label">FIRST IMPRESSION</div>
                    <div class="tag-value">{{ review.impression_text | default: 'EXCEEDED' }}</div>
                  </div>
                </div>

                <a class="full-story-link" onclick="openModal('{{ block.id }}')">
                  {{ review.modal_opener_button_label | default: 'FULL STORY' }}
                </a>

                <div class="reviewer-info">
                  <div class="verified-icon">✓</div>
                  <div>
                    {% if review.reviewer_name and review.reviewer_city %}
                      {{ review.reviewer_name }} // {{ review.reviewer_city }}
                    {% else %}
                      NAME // CITY
                    {% endif %}
                  </div>
                  <div>{{ review.reviewer_date | default: 'DATE' }}</div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="carousel-nav">
      <button class="nav-arrow" id="prevBtn">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="carousel-dots" id="dotsContainer"></div>

      <button class="nav-arrow" id="nextBtn">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Modal -->
  <div id="reviewModal" class="modal">
    <div class="modal-content">
      <button class="modal-close" onclick="closeModal()">&times;</button>

      <div class="modal-image-container" id="modalImageContainer">
        <div class="warning-badge">
          <div>WEARING:</div>
          <div id="modalProductName">PRODUCT NAME</div>
        </div>
        <div class="product-image-text" id="modalImagePlaceholder">PRODUCT IMAGE</div>
      </div>

      <div class="modal-body">
        <div class="modal-user-images" id="modalUserImages">
          <!-- Images will be populated dynamically by JavaScript -->
        </div>

        <div class="modal-review-header">
          <h2 class="modal-title" id="modalTitle">TITLE</h2>
          <div class="modal-stars" id="modalStars"></div>
        </div>

        <div class="modal-full-review" id="modalFullReview"></div>

        <div class="modal-review-tags">
          <div class="modal-tag">
            <div class="modal-tag-label">RECOMMEND</div>
            <div class="modal-tag-value" id="modalRecommend">YES</div>
          </div>
          <div class="modal-tag">
            <div class="modal-tag-label">PERFORMANCE</div>
            <div class="modal-tag-value" id="modalPerformance">GOOD</div>
          </div>
          <div class="modal-tag">
            <div class="modal-tag-label">FIRST IMPRESSION</div>
            <div class="modal-tag-value" id="modalImpression">EXCEEDED</div>
          </div>
        </div>

        <div class="modal-reviewer-info">
          <div class="verified-icon">✓</div>
          <div id="modalReviewer">NAME // CITY</div>
          <div id="modalDate">DATE</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Store review data for modal
  const reviewData = {
    {% for block in section.blocks %}
      {% assign review = block.settings %}
      {% assign star_count = 5 %}
      {% case review.review_star %}
        {% when 'one' %}{% assign star_count = 1 %}
        {% when 'two' %}{% assign star_count = 2 %}
        {% when 'three' %}{% assign star_count = 3 %}
        {% when 'four' %}{% assign star_count = 4 %}
        {% when 'five' %}{% assign star_count = 5 %}
      {% endcase %}
      '{{ block.id }}': {
        productName: {{ review.review_product.title | default: 'PRODUCT NAME' | json }},
        productImage: {{ review.review_product.featured_media | img_url: 'master' | json }},
        title: {{ review.review_title | default: 'TITLE' | json }},
        stars: {{ star_count }},
        fullReview: {{ review.review_text | default: '' | json }},
        recommend: {{ review.recommend_text | default: 'YES' | json }},
        performance: {{ review.performance_text | default: 'GOOD' | json }},
        impression: {{ review.impression_text | default: 'EXCEEDED' | json }},
        reviewerName: {{ review.reviewer_name | default: '' | json }},
        reviewerCity: {{ review.reviewer_city | default: '' | json }},
        reviewerDate: {{ review.reviewer_date | default: 'DATE' | json }},
        reviewImages: [
          {% if review.review_image_1 %}{{ review.review_image_1 | img_url: 'medium' | json }}{% else %}null{% endif %},
          {% if review.review_image_2 %}{{ review.review_image_2 | img_url: 'medium' | json }}{% else %}null{% endif %},
          {% if review.review_image_3 %}{{ review.review_image_3 | img_url: 'medium' | json }}{% else %}null{% endif %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // Modal Functions
  function openModal(blockId) {
    const modal = document.getElementById('reviewModal');
    const data = reviewData[blockId];
    
    if (!data) return;

    // Update modal content
    document.getElementById('modalProductName').textContent = data.productName.toUpperCase();
    document.getElementById('modalTitle').textContent = data.title;
    document.getElementById('modalRecommend').innerHTML = data.recommend;
    document.getElementById('modalPerformance').innerHTML = data.performance;
    document.getElementById('modalImpression').innerHTML = data.impression;
    document.getElementById('modalDate').textContent = data.reviewerDate;
    
    // Update reviewer info
    if (data.reviewerName && data.reviewerCity) {
      document.getElementById('modalReviewer').textContent = `${data.reviewerName} // ${data.reviewerCity}`;
    } else {
      document.getElementById('modalReviewer').textContent = 'NAME // CITY';
    }
    
    // Update full review
    const reviewContent = document.getElementById('modalFullReview');
    reviewContent.innerHTML = data.fullReview || '<p>No detailed review available.</p>';
    
    // Update product image
    const imageContainer = document.getElementById('modalImageContainer');
    const imagePlaceholder = document.getElementById('modalImagePlaceholder');
    if (data.productImage) {
      imageContainer.style.backgroundImage = `url('${data.productImage}')`;
      imagePlaceholder.style.display = 'none';
    } else {
      imageContainer.style.backgroundImage = 'none';
      imagePlaceholder.style.display = 'block';
    }
    
    // Update stars
    const starsContainer = document.getElementById('modalStars');
    starsContainer.innerHTML = '';
    for (let i = 1; i <= 5; i++) {
      const star = document.createElement('span');
      star.className = i <= data.stars ? 'star' : 'star empty';
      star.textContent = '★';
      starsContainer.appendChild(star);
    }
    
    // Update review images in modal
    const userImagesContainer = document.getElementById('modalUserImages');
    userImagesContainer.innerHTML = '';
    
    data.reviewImages.forEach((imageUrl) => {
      const imageDiv = document.createElement('div');
      imageDiv.className = 'modal-user-image';
      
      if (imageUrl) {
        imageDiv.style.backgroundImage = `url('${imageUrl}')`;
        imageDiv.style.backgroundSize = 'cover';
        imageDiv.style.backgroundPosition = 'center';
      } else {
        imageDiv.innerHTML = 'USER<br />IMAGES//<br />VIDEOS';
      }
      
      userImagesContainer.appendChild(imageDiv);
    });
    
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    const modal = document.getElementById('reviewModal');
    modal.classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  // Close modal when clicking outside
  window.onclick = function(event) {
    const modal = document.getElementById('reviewModal');
    if (event.target === modal) {
      closeModal();
    }
  }

  // Close modal on ESC key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeModal();
    }
  });

  class ReviewCarousel {
    constructor() {
      this.wrapper = document.getElementById('carouselWrapper');
      this.prevBtn = document.getElementById('prevBtn');
      this.nextBtn = document.getElementById('nextBtn');
      this.dotsContainer = document.getElementById('dotsContainer');
      this.cards = document.querySelectorAll('.review-card');
      this.currentIndex = 0;
      this.cardsPerView = this.getCardsPerView();
      this.totalSlides = Math.ceil(this.cards.length / this.cardsPerView);

      this.init();
    }

    getCardsPerView() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 768) return 2;
      return 1;
    }

    init() {
      this.createDots();
      this.updateCarousel();
      this.attachEventListeners();
    }

    createDots() {
      this.dotsContainer.innerHTML = '';
      for (let i = 0; i < this.totalSlides; i++) {
        const dot = document.createElement('div');
        dot.classList.add('dot');
        if (i === 0) dot.classList.add('active');
        dot.addEventListener('click', () => this.goToSlide(i));
        this.dotsContainer.appendChild(dot);
      }
    }

    attachEventListeners() {
      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          const newCardsPerView = this.getCardsPerView();
          if (newCardsPerView !== this.cardsPerView) {
            this.cardsPerView = newCardsPerView;
            this.totalSlides = Math.ceil(this.cards.length / this.cardsPerView);
            this.currentIndex = Math.min(this.currentIndex, this.totalSlides - 1);
            this.createDots();
            this.updateCarousel();
          }
        }, 250);
      });

      // Touch events for mobile swipe
      let startX = 0;
      let isDragging = false;

      this.wrapper.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        isDragging = true;
      });

      this.wrapper.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
      });

      this.wrapper.addEventListener('touchend', (e) => {
        if (!isDragging) return;
        isDragging = false;
        const endX = e.changedTouches[0].clientX;
        const diff = startX - endX;

        if (Math.abs(diff) > 50) {
          if (diff > 0) {
            this.next();
          } else {
            this.prev();
          }
        }
      });
    }

    updateCarousel() {
      const translateX = -(this.currentIndex * (100 / this.cardsPerView));
      this.wrapper.style.transform = `translateX(${translateX}%)`;

      this.prevBtn.disabled = this.currentIndex === 0;
      this.nextBtn.disabled = this.currentIndex >= this.totalSlides - 1;

      document.querySelectorAll('.dot').forEach((dot, index) => {
        dot.classList.toggle('active', index === this.currentIndex);
      });
    }

    next() {
      if (this.currentIndex < this.totalSlides - 1) {
        this.currentIndex++;
        this.updateCarousel();
      }
    }

    prev() {
      if (this.currentIndex > 0) {
        this.currentIndex--;
        this.updateCarousel();
      }
    }

    goToSlide(index) {
      this.currentIndex = index;
      this.updateCarousel();
    }
  }

  // Initialize carousel when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    new ReviewCarousel();
  });
</script>


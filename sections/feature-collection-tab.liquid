{% style %}
  .feature-collection-tab-wrapper {
    padding-top: {{ section.settings.desktop_top_padding }}px;
    padding-bottom: {{ section.settings.desktop_bottom_padding }}px;
  }

  @media screen and (max-width: 900px) {
    .feature-collection-tab-wrapper {
      padding-top: {{ section.settings.mobile_top_padding }}px;
      padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
    }
  }
{% endstyle %}

<style>
  .feature-collection-tab-header-container {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 48px;
  }

  .feature-collection-tab-section-heading {
    margin-bottom: 0;
    font-size: 42px;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 39.9px;
    white-space: nowrap;
  }

  .feature-collection-tab-headers {
    display: flex;
    gap: 32px;
    border-bottom: 1px solid #e5e7eb;
  }

  .feature-collection-tab-headers .tab-btn {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    padding: 10px 0;
    cursor: pointer;
    background: none;
    border: none;
    color: #999;
    transition: color 0.3s ease;
    position: relative;
    letter-spacing: 1px;
  }

  .feature-collection-tab-headers .tab-btn:hover {
    color: #C93825;
  }

  .feature-collection-tab-headers .tab-btn.active {
    color: #C93825;
  }

  .feature-collection-tab-headers .tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #C93825;
  }

  .feature-collection-tab-section-container {
    margin-top: 40px;
    position: relative;
    min-height: 500px;
  }

  .feature-collection-tab-section-container .slider-container-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1)
    , transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)
    , visibility 0.4s;
    pointer-events: none;
  }

  .feature-collection-tab-section-container .slider-container-wrapper.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    position: relative;
    pointer-events: auto;
    z-index: 1;
  }

  .slider-container {
    position: relative;
    overflow: hidden;
    padding: 0;
  }

  .slider-wrapper {
    display: flex;
    gap: 16px;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border: 1px solid #ddd;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.3s ease;
    opacity: 1;
  }

  .nav-btn:hover:not(.disabled) {
    background-color: #C93825;
    border-color: #C93825;
  }

  .nav-btn:hover:not(.disabled)::before {
    border-color: white;
  }

  .nav-btn.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .nav-btn.prev {
    left: 0;
  }

  .nav-btn.next {
    right: 0;
  }

  .nav-btn::before {
    content: '';
    width: 12px;
    height: 12px;
    border-top: 2px solid #1a1a1a;
    border-right: 2px solid #1a1a1a;
    transition: border-color 0.3s ease;
  }

  .nav-btn.prev::before {
    transform: rotate(-135deg);
    margin-left: 3px;
  }

  .nav-btn.next::before {
    transform: rotate(45deg);
    margin-right: 3px;
  }

  @media screen and (max-width: 900px) {
    .feature-collection-tab-header-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .feature-collection-tab-section-heading {
      font-size: 32px;
      line-height: 1.2;
      white-space: normal;
    }

    .feature-collection-tab-headers {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      width: 100%;
      padding-bottom: 2px;
    }

    .slider-container {
      padding: 0;
    }

    .nav-btn {
      width: 40px;
      height: 40px;
    }

    .nav-btn.prev {
      left: 5px;
    }

    .nav-btn.next {
      right: 5px;
    }
    .feature-collection-tab-headers {
      gap: 16px;
    }

    .feature-collection-tab-headers::-webkit-scrollbar {
      display: none;
    }

    .feature-collection-tab-headers {
      scrollbar-width: none;
    }

    .feature-collection-tab-headers {
      -ms-overflow-style: none;
    }
  }

  @media screen and (max-width: 480px) {
    .feature-collection-tab-section-heading {
      font-size: 28px;
    }

    .feature-collection-tab-headers .tab-btn {
      font-size: 11px;
      white-space: nowrap;
    }

    .slider-container {
      padding: 0;
    }

    .nav-btn {
      width: 35px;
      height: 35px;
    }
  }


  .slider-wrapper .product-card-wrapper {
    flex: 0 0 auto;
    min-width: 335px;
    width: calc(25% - 12px);
  }

  @media screen and (max-width: 1200px) {
    .slider-wrapper .product-card-wrapper {
      width: calc(40% - 10px);
      min-width: 280px;
    }
  }

  @media screen and (max-width: 768px) {
    .slider-wrapper .product-card-wrapper {
      width: calc(50% - 8px);
      min-width: 240px;
    }
  }

  @media screen and (max-width: 480px) {
    .slider-wrapper .product-card-wrapper {
      width: calc(50% - 8px);
      min-width: 150px;
    }

    .feature-collection-tab-section-container {
      min-height: 300px;
    }
  }

</style>

<div class="feature-collection-tab-wrapper">
  <div class="feature-collection-tab-header-container">
    <div class="feature-collection-tab-section-heading">
      {{ section.settings.section_heading }}
    </div>

    <div class="feature-collection-tab-headers">
      {% for collectionBlock in section.settings.feature_collection_list %}
        <button
          class="tab-btn {% if forloop.index == 1 %}active{% endif %}"
          data-tab="{{ collectionBlock.title | handleize }}"
          data-tab-index="{{ forloop.index0 }}">
          {{ collectionBlock.title }}
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="feature-collection-tab-section-container">
    {% for collectionBlock in section.settings.feature_collection_list %}
      <div
        class="slider-container-wrapper {% if forloop.index == 1 %}active{% endif %}"
        id="{{ collectionBlock.title | handleize }}"
        data-slider-id="slider-{{ forloop.index0 }}">
        <div class="slider-container">
          <button
            class="nav-btn prev"
            data-slider="slider-{{ forloop.index0 }}"
            data-direction="-1">
            <span class="visually-hidden">Previous</span>
          </button>

          <div class="slider-wrapper" data-wrapper="slider-{{ forloop.index0 }}">
            {% for collectionProduct in collectionBlock.products limit: 12 %}
              {% liquid
                assign feature_product = collectionProduct
              %}
              {% capture children %}
                {% content_for 'block',
                  type: '_product-card-gallery',
                  id: 'feature-product-card-gallery',
                  closest.product: feature_product
                %}
                {% content_for 'block',
                  type: 'product-title',
                  id: 'feature-product-title',
                  closest.product: feature_product
                %}
                {% content_for 'block',
                  type: 'price',
                  id: 'feature-product-price',
                  closest.product: feature_product
                %}
              {% endcapture %}
              <div class="product-card-wrapper">
                {% render 'product-card'
                  , children: children
                  , product: feature_product %}
              </div>
            {% endfor %}
          </div>

          <button
            class="nav-btn next"
            data-slider="slider-{{ forloop.index0 }}"
            data-direction="1">
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function() {
  'use strict';
  
  const sliders = {};
  
  function initSliders() {
    document.querySelectorAll('.slider-container-wrapper').forEach((wrapper) => {
      const sliderId = wrapper.dataset.sliderId;
      const sliderWrapper = wrapper.querySelector(`[data-wrapper="${sliderId}"]`);
      const prevBtn = wrapper.querySelector(`.nav-btn.prev[data-slider="${sliderId}"]`);
      const nextBtn = wrapper.querySelector(`.nav-btn.next[data-slider="${sliderId}"]`);
  
      if (!sliderWrapper || !prevBtn || !nextBtn) return;
  
      sliders[sliderId] = {
        currentSlide: 0,
        wrapper: sliderWrapper,
        prevBtn: prevBtn,
        nextBtn: nextBtn,
        container: wrapper
      };
  
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        slideProducts(sliderId, -1);
      });
  
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        slideProducts(sliderId, 1);
      });
  
      updateNavigationButtons(sliderId);
    });
  }
  
  function getVisibleCards() {
  const width = window.innerWidth;
  if (width <= 768) return 2;
  if (width <= 1200) return 2.5;
  return 4;
  }
  
  function updateSlider(sliderId) {
    const slider = sliders[sliderId];
    if (!slider || !slider.wrapper) return;
  
    const cards = slider.wrapper.querySelectorAll('.product-card-wrapper');
    if (cards.length === 0) return;
  
    const cardWidth = cards[0].offsetWidth;
    const gap = 16;
    const offset = -(slider.currentSlide * (cardWidth + gap));
  
    slider.wrapper.style.transform = `translateX(${offset}px)`;
    updateNavigationButtons(sliderId);
  }
  
  function updateNavigationButtons(sliderId) {
  const slider = sliders[sliderId];
  if (!slider) return;
  
  const cards = slider.wrapper.querySelectorAll('.product-card-wrapper');
  const totalCards = cards.length;
  const visibleCards = getVisibleCards();
  const maxSlide = Math.max(0, Math.ceil(totalCards - visibleCards)); 
  
  if (slider.currentSlide <= 0) {
    slider.prevBtn.classList.add('disabled');
  } else {
    slider.prevBtn.classList.remove('disabled');
  }
  
  if (slider.currentSlide >= maxSlide) {
    slider.nextBtn.classList.add('disabled');
  } else {
    slider.nextBtn.classList.remove('disabled');
  }
  }
  
  function slideProducts(sliderId, direction) {
  const slider = sliders[sliderId];
  if (!slider) return;
  
  const cards = slider.wrapper.querySelectorAll('.product-card-wrapper');
  const totalCards = cards.length;
  const visibleCards = getVisibleCards();
  const maxSlide = Math.max(0, Math.ceil(totalCards - visibleCards));
  
  const newSlide = slider.currentSlide + direction;
  
  if (newSlide >= 0 && newSlide <= maxSlide) {
    slider.currentSlide = newSlide;
    updateSlider(sliderId);
  }
  }
  
  function initTabs() {
    const tabButtons = document.querySelectorAll('.feature-collection-tab-headers .tab-btn');
    const tabPanels = document.querySelectorAll('.feature-collection-tab-section-container .slider-container-wrapper');
  
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const targetTab = button.getAttribute('data-tab');
        const tabIndex = button.getAttribute('data-tab-index');
  
        tabButtons.forEach(btn => btn.classList.remove('active'));
        tabPanels.forEach(panel => panel.classList.remove('active'));
  
        button.classList.add('active');
        const targetPanel = document.getElementById(targetTab);
        
        if (targetPanel) {
          targetPanel.classList.add('active');
  
          const sliderId = targetPanel.dataset.sliderId;
          if (sliders[sliderId]) {
            sliders[sliderId].currentSlide = 0;
            setTimeout(() => {
              updateSlider(sliderId);
            }, 100);
          }
        }
      });
    });
  }
  
  let resizeTimer;
  function handleResize() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      Object.keys(sliders).forEach(sliderId => {
        sliders[sliderId].currentSlide = 0;
        updateSlider(sliderId);
      });
    }, 250);
  }
  
  function init() {
    initSliders();
    initTabs();
    window.addEventListener('resize', handleResize);
  
    requestAnimationFrame(finalizeInit);
    setTimeout(finalizeInit, 400);
    window.addEventListener('load', finalizeInit);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  })();
</script>

{% schema %}
  {
    "name": "Feature collection tab",
    "class": "feature-collection-tab-container section section--page-width",
    "settings": [
      {
        "type": "header",
        "content": "Section heading",
        "info": "Customize the section heading"
      },
      {
        "type": "text",
        "id": "section_heading",
        "label": "Heading",
        "default": "Our suggestions for"
      },
      {
        "type": "collection_list",
        "id": "feature_collection_list",
        "label": "Collections",
        "limit": 4
      },
      {
        "type": "header",
        "content": "Section spacings",
        "info": "Customize the spacing/paddings for the section for both desktop as well as mobile devices..."
      }, {
        "type": "paragraph",
        "content": "Mention top and bottom paddings for the desktop devices."
      }, {
        "type": "number",
        "id": "desktop_top_padding",
        "label": "Desktop top padding",
        "default": 120
      }, {
        "type": "number",
        "id": "desktop_bottom_padding",
        "label": "Desktop bottom padding",
        "default": 120
      }, {
        "type": "paragraph",
        "content": "Mention top and bottom paddings for the mobile devices."
      }, {
        "type": "number",
        "id": "mobile_top_padding",
        "label": "Mobile top padding",
        "default": 60
      }, {
        "type": "number",
        "id": "mobile_bottom_padding",
        "label": "Mobile bottom padding",
        "default": 60
      }
    ],
    "presets": [
      {
        "name": "Feature collection tab",
        "category": "Custom"
      }
    ],
    "enabled_on": {
      "templates": ["*"]
    }
  }
{% endschema %}